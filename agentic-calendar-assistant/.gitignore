# ==========================================
# 🔒 Environment & Secret Files (CRITICAL)
# ==========================================
.env
.env.*
*.env
backend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.production
frontend/.env.development

# Allow .env.example files for reference
!.env.example
!backend/.env.example
!frontend/.env.example

# ==========================================
# 📦 Dependencies
# ==========================================
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

